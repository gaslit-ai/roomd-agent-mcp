{
  "name": "@gaslit-ai/roomd-agent-mcp",
  "version": "0.1.0",
  "description": "An MCP-hosted agent runtime: an opencode-backed agent exposed over MCP as task-augmented tools. A standalone primitive, independent of any consumer.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gaslit-ai/roomd-agent-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/opencode-server/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opencode-ai/sdk": "^1.15.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
